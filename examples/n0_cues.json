{"duration": 50.877, "lines": [{"t": 0.931, "text": "Ranking tematów liczy filmy, w"}, {"t": 2.578, "text": "których dany temat pada co najmniej"}, {"t": 4.037, "text": "trzy razy."}, {"t": 5.078, "text": "Na czele jest Klod od firmy"}, {"t": 6.384, "text": "Antropik, obecny w stu dwóch filmach"}, {"t": 8.429, "text": "na dziesięciu kanałach."}, {"t": 9.931, "text": "Tuż za nim agenci AI, potem Klod"}, {"t": 12.087, "text": "Kołd, czyli Klod pracujący na"}, {"t": 13.677, "text": "plikach w twoim komputerze."}, {"t": 15.44, "text": "Roboty wyprzedzają nawet Kodeksa i"}, {"t": 17.077, "text": "dżi-pi-ti 6 Astrę, bo wracały w"}, {"t": 18.937, "text": "cotygodniowych przeglądach Kuby"}, {"t": 20.383, "text": "Klawitera i Aleksa Szacha."}, {"t": 22.233, "text": "Modele chińskie pojawiają się"}, {"t": 23.577, "text": "rzadziej, ale za to na wszystkich"}, {"t": 25.128, "text": "jedenastu kanałach."}, {"t": 26.711, "text": "Ten sam korpus miesiąc po miesiącu"}, {"t": 28.577, "text": "pokazuje rytm premier."}, {"t": 30.18, "text": "W lipcu Antropik pojawiał się w"}, {"t": 31.678, "text": "sześćdziesięciu trzech procentach"}, {"t": 32.937, "text": "filmów."}, {"t": 33.882, "text": "W sierpniu Open ej-aj spadł do"}, {"t": 35.482, "text": "jednej czwartej, a we wrześniu"}, {"t": 37.177, "text": "wrócił do sześćdziesięciu procent."}, {"t": 39.031, "text": "Ten skok ma jedną nazwę, dżi-pi-ti 6"}, {"t": 41.427, "text": "Astra, i dojdziemy do niej w drugiej"}, {"t": 43.195, "text": "części."}, {"t": 44.129, "text": "Modele chińskie najmocniej"}, {"t": 45.438, "text": "wybrzmiały w lipcu i sierpniu, przy"}, {"t": 47.282, "text": "premierach Kimi ka trzy i Kłen trzy"}, {"t": 49.077, "text": "kropka osiem."}]}